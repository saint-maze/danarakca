{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/admin",
      "destination": "/danarakca/static/admin-login.html"
    },
    {
      "source": "/admin/",
      "destination": "/danarakca/static/admin-login.html"
    },
    {
      "source": "/facilitator",
      "destination": "/danarakca/static/facilitator.html"
    },
    {
      "source": "/player",
      "destination": "/danarakca/static/player.html"
    },
    {
      "source": "/broadcast",
      "destination": "/danarakca/static/broadcast.html"
    },
    {
      "source": "/broadcast/",
      "destination": "/danarakca/static/broadcast.html"
    },
    {
      "source": "/screen",
      "destination": "/danarakca/static/broadcast.html"
    },
    {
      "source": "/screen/",
      "destination": "/danarakca/static/broadcast.html"
    },
    {
      "source": "/",
      "destination": "/danarakca/static/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/danarakca/static/$1"
    }
  ]
}
