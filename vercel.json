{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(), focus-without-user-activation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/admin",
      "destination": "/danarakca/static/admin-login.html"
    },
    {
      "source": "/admin/",
      "destination": "/danarakca/static/admin-login.html"
    },
    {
      "source": "/facilitator",
      "destination": "/danarakca/static/facilitator.html"
    },
    {
      "source": "/player",
      "destination": "/danarakca/static/player.html"
    },
    {
      "source": "/broadcast",
      "destination": "/danarakca/static/broadcast.html"
    },
    {
      "source": "/broadcast/",
      "destination": "/danarakca/static/broadcast.html"
    },
    {
      "source": "/screen",
      "destination": "/danarakca/static/broadcast.html"
    },
    {
      "source": "/screen/",
      "destination": "/danarakca/static/broadcast.html"
    },
    {
      "source": "/",
      "destination": "/danarakca/static/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/danarakca/static/$1"
    }
  ]
}
